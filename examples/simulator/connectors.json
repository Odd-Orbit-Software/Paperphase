    {
      "id": "rss.headlines",
      "name": "RSS and Atom headlines",
      "description": "Reads public UTF-8 RSS 2.0 or Atom feeds. Uses the saved feed URL as its host-granted origin. Check the publisher's access, attribution and polling terms. No article pages or images are fetched.",
      "min_poll_secs": 900,
      "default_poll_secs": 1800,
      "settings": [
        {
          "id": "label",
          "label": "Feed label",
          "required": true,
          "input": {
            "type": "text",
            "max_bytes": 128,
            "default": "Headlines"
          }
        },
        {
          "id": "feed_url",
          "label": "Feed URL",
          "required": true,
          "help": "The canonical public HTTP(S) feed URL. Redirects and URL credentials are not supported.",
          "input": {
            "type": "url"
          }
        },
        {
          "id": "max_items",
          "label": "Headlines to show",
          "input": {
            "type": "integer",
            "min": 1,
            "max": 5,
            "default": 3
          }
        }
      ],
      "templates": [
        {
          "id": "rss-headlines",
          "name": "Headlines",
          "component": {
            "id": "rss-headlines",
            "rect": {
              "x": 0,
              "y": 0,
              "width": 432,
              "height": 176
            },
            "padding": 8,
            "gap": 4,
            "border": true,
            "content_layout": "flow",
            "blocks": [
