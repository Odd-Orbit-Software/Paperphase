{
  "schema_version": 1,
  "connectors": [
    {
      "id": "demo.weather",
      "name": "Demo weather settings",
      "description": "A settings-only example. Saving a connection does not fetch weather or change the sample datasets yet.",
      "min_poll_secs": 30,
      "default_poll_secs": 300,
      "settings": [
        {
          "id": "location",
          "label": "Location",
          "help": "A label for this weather location.",
          "required": true,
          "input": {
            "type": "text",
            "max_bytes": 128,
            "default": "Dublin"
          }
        },
        {
          "id": "units",
          "label": "Units",
          "input": {
            "type": "choice",
            "default": "metric",
            "options": [
              {
                "value": "metric",
                "label": "Metric"
              },
              {
                "value": "imperial",
                "label": "Imperial"
              }
            ]
          }
        },
        {
          "id": "forecast_days",
          "label": "Forecast days",
          "input": {
            "type": "integer",
            "min": 1,
            "max": 7,
            "default": 3
          }
        },
        {
          "id": "include_summary",
          "label": "Include summary",
          "input": {
            "type": "boolean",
            "default": true
          }
        },
        {
          "id": "test_secret",
          "label": "Test secret",
          "help": "Optional private value for exercising secret settings. It is never sent to an API.",
          "input": {
            "type": "secret",
            "max_bytes": 256
          }
        }
      ]
    },
    {
      "id": "example.temperature",
      "name": "Temperature connector",
      "description": "Reads a temperature observation from the source granted by the host. Register the compiled example module to enable fetching.",
      "min_poll_secs": 30,
      "default_poll_secs": 300,
      "settings": [
        {
          "id": "location",
          "label": "Location label",
          "required": true,
          "input": {
            "type": "text",
            "max_bytes": 128,
            "default": "Dublin"
          }
        },
        {
          "id": "units",
          "label": "Display units",
          "input": {
            "type": "choice",
            "default": "metric",
            "options": [
              {
                "value": "metric",
                "label": "Celsius"
              },
              {
                "value": "imperial",
                "label": "Fahrenheit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "weather.open-meteo",
      "name": "Open-Meteo weather",
      "description": "Current conditions, hourly and daily model forecasts. Free non-commercial API; retain attribution to Open-Meteo under CC BY 4.0. Coordinates determine the local forecast timezone.",
      "min_poll_secs": 600,
      "default_poll_secs": 900,
      "settings": [
        {
          "id": "location",
          "label": "Location label",
          "required": true,
          "input": {
            "type": "text",
            "max_bytes": 128,
            "default": "Dublin"
          }
        },
        {
          "id": "latitude",
          "label": "Latitude",
          "required": true,
          "input": {
            "type": "number",
            "min": -90,
            "max": 90,
            "default": 53.3498
          }
        },
        {
          "id": "longitude",
          "label": "Longitude",
          "required": true,
          "input": {
            "type": "number",
            "min": -180,
            "max": 180,
            "default": -6.2603
          }
        },
        {
          "id": "units",
          "label": "Display units",
          "input": {
            "type": "choice",
            "default": "metric",
            "options": [
              {
                "value": "metric",
                "label": "Celsius"
              },
              {
                "value": "imperial",
                "label": "Fahrenheit"
              }
            ]
          }
        },
        {
          "id": "forecast_hours",
          "label": "Hourly forecast length",
          "input": {
            "type": "integer",
            "min": 6,
            "max": 48,
            "default": 24
          }
        },
        {
          "id": "forecast_days",
          "label": "Daily forecast length",
          "input": {
            "type": "integer",
            "min": 1,
            "max": 7,
            "default": 3
          }
        },
        {
          "id": "rain_threshold",
          "label": "Likely rain probability (%)",
          "help": "Rain timing requires at least this probability and 0.1 mm of forecast rain. Hourly estimates are not precise start times.",
          "input": {
            "type": "integer",
            "min": 1,
            "max": 100,
            "default": 50
          }
        }
      ],
      "templates": [
        {
