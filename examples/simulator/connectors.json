                  "text": "HEADLINES"
                },
                "font_size": 11,
                "overflow": "wrap"
              },
              {
                "id": "headlines",
                "source": {
                  "kind": "field",
                  "binding": {
                    "connection_id": "template",
                    "dataset_id": "headlines",
                    "field_id": "headlines",
                    "row": 0
                  }
                },
                "font_size": 14,
                "overflow": "wrap"
              }
            ],
            "label": "Headlines"
          }
        }
      ]
    },
